# Database connection string (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/adu99_photography?schema=public"

# Authentication & Session Security (Minimum 32 random characters for production)
AUTH_SECRET="your-secure-random-32-char-secret"
ADMIN_DEFAULT_EMAIL="admin@adu99photography.com"
ADMIN_DEFAULT_PASSWORD="YourSecureAdminPassword123!"

# Application Settings & Brand Identifiers
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_BUSINESS_NAME="ADU99 Photography"
NEXT_PUBLIC_WHATSAPP_NUMBER="+220XXXXXXX"
NEXT_PUBLIC_BUSINESS_EMAIL="contact@adu99photography.com"
NEXT_PUBLIC_DEFAULT_CURRENCY="GMD"
NEXT_PUBLIC_DEFAULT_TIMEZONE="Africa/Banjul"

# Optional Email Integration (Resend) - leaving empty uses built-in notification logger
RESEND_API_KEY=""
EMAIL_FROM="ADU99 Photography <bookings@yourdomain.com>"

# Optional Media CDN (Cloudinary) - leaving empty uses local asset hosting and placeholders
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_UPLOAD_PRESET=""
